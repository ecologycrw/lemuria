{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(py tools/dev.py:*)",
      "Bash(python3 tools/dev.py:*)",
      "Bash(py tools/checks/run.py:*)",
      "Bash(python3 tools/checks/run.py:*)",
      "PowerShell(py tools/dev.py:*)",
      "PowerShell(py tools/checks/run.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c fatia/:*)",
      "Bash(git switch -c consolidacao/:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin fatia/:*)",
      "Bash(git push origin fatia/:*)",
      "Bash(git push -u origin consolidacao/:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(.githooks/**)",
      "Edit(.github/**)",
      "Edit(cmake/**)",
      "Edit(CMakePresets.json)",
      "Edit(vcpkg.json)",
      "Edit(vcpkg-configuration.json)",
      "Edit(.clang-format)",
      "Edit(.clang-tidy)",
      "Edit(.editorconfig)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(tools/dev.py)",
      "Edit(tools/checks/**)",
      "Edit(tests/architecture/**)",
      "Edit(tests/hooks/**)",
      "Edit(docs/VISION.md)",
      "Edit(docs/ROADMAP.md)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(gh auth:*)",
      "Bash(gh api:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-central.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ps1\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
